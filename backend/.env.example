# Copy to backend/.env and fill in. Never commit .env.

# One OpenAI key powers everything: reasoning (agents, briefings, chat, memory) and the RAG embeddings.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Reasoning provider: "openai" (default) or "anthropic" (then set ANTHROPIC_API_KEY)
# LLM_PROVIDER=openai
# ANTHROPIC_API_KEY=

# Optional overrides (defaults shown for LLM_PROVIDER=openai)
# COORDINATOR_MODEL=gpt-5.5        # briefings + chat answers
# HAZARD_AGENT_MODEL=gpt-5.4-mini  # the 5 specialist agents
# MEMORY_MODEL=gpt-5.4-mini        # long-term memory extraction
# COORDINATOR_EFFORT=low           # reasoning effort: low | medium | high
# HAZARD_AGENT_EFFORT=low
# EMBED_PROVIDER=openai            # or: local (downloads BAAI/bge-small-en-v1.5)
# USE_DENSE=1                      # 0 = BM25-only retrieval
# TOP_K=6
# DONKI_LOOKBACK_DAYS=7
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
