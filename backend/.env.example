# Copy to backend/.env and fill in. Never commit .env.

# Required for the agents (briefings + chat). Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# Embeddings for the RAG search. With OPENAI_API_KEY set, OpenAI embeddings are used;
# without it, a local model (BAAI/bge-small-en-v1.5) is downloaded and used instead.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional overrides (defaults shown)
# EMBED_PROVIDER=openai      # or: local
# COORDINATOR_MODEL=claude-opus-5-5
# HAZARD_AGENT_MODEL=claude-opus-5-5
# COORDINATOR_EFFORT=medium
# HAZARD_AGENT_EFFORT=low
# USE_FALLBACKS=1            # server-side refusal fallback (beta)
# USE_DENSE=1                # 0 = BM25-only retrieval (no embedding model download)
# TOP_K=6
# DONKI_LOOKBACK_DAYS=7
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
