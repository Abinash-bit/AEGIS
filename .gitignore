# ─────────────────────────────────────────────────────────────
#  AEGIS · space-apps-2026
# ─────────────────────────────────────────────────────────────

# ── Secrets (API keys live in Render's environment settings) ──
.env
.env.*
!.env.example
*.pem
*.key

# ── Python / backend ──
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# backend runtime caches: DONKI responses, embedding vectors, local embedding model, logs
backend/.cache/

# backend runtime database: chats, memories, check-ins, reports (created automatically)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# ── Node / frontend ──
node_modules/
dist/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Logs and OS / editor files ──
*.log
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── Large media not needed to run the app ──
# (the original PNG illustrations in images/ are kept; the app uses the WebP copies in frontend/public/images/)
media/*.mp4
media/*.mov
